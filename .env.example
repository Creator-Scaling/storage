# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Apify — https://console.apify.com/account/integrations
APIFY_API_TOKEN=apify_api_...

# Apollo.io — https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=...

# Google — create a Service Account and share your Sheet + Drive folder with it
# Download the JSON key and point this to the file path
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# The ID from your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/SHEET_ID_HERE/edit
GOOGLE_SHEETS_ID=

# The Google Drive folder ID where audit docs will be created
# Share this folder with your service account email
GOOGLE_DRIVE_FOLDER_ID=
