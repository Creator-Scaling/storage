# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Apify — https://console.apify.com/account/integrations
APIFY_API_TOKEN=apify_api_...

# Apollo.io — https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=...

# Google — create a Service Account and share your Sheet with it
# Download the JSON key and point this to the file path
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# The ID from your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/SHEET_ID_HERE/edit
GOOGLE_SHEETS_ID=

# GitHub Pages — audit HTML pages are deployed here
# 1. Create a repo (e.g. your-org/audits)
# 2. Go to Settings → Pages → Source: Deploy from branch (main, root)
# 3. Create a Personal Access Token with repo scope
GITHUB_TOKEN=ghp_...
GITHUB_PAGES_REPO=your-org/audits
GITHUB_PAGES_BRANCH=main
GITHUB_PAGES_PATH=
# Optional: if you have a custom domain pointed at Pages
GITHUB_PAGES_CUSTOM_DOMAIN=
